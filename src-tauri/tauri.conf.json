{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dune Server Manager",
  "version": "1.1.0",
  "identifier": "dev.jakub.duneservermanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Dune Server Manager",
        "width": 1480,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": false,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Dune: Awakening server manager",
    "windows": { "nsis": { "installMode": "perMachine" } }
  }
}
